# ===== 服务 =====
PORT=8325

# ===== 大模型（硅基流动 / 七牛云 / 任意 OpenAI 兼容平台）=====
LLM_BASE_URL=https://api.qnaigc.com/v1
LLM_MODEL=qiniu/conatus-free
LLM_API_KEY=请填写你的_API_KEY
LLM_TIMEOUT=90000
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1600

# ===== 多模态（硅基流动 SiliconFlow）=====
# 生图：OpenMOSS-Team/MOSS-Image（文生图，长文本排版强）
# 语音：Qwen/Qwen2.5-Omni-7B （音频→文本 ASR）
SF_BASE_URL=https://api.siliconflow.cn/v1
SF_API_KEY=请填写硅基流动_API_KEY
SF_IMAGE_MODEL=OpenMOSS-Team/MOSS-Image
SF_SPEECH_MODEL=Qwen/Qwen2.5-Omni-7B
SF_TIMEOUT=120000

# ===== 数据库（MySQL 8.0；置为 false 时自动退化为本地 JSON 存储）=====
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=llm_rag

# ===== RAG 参数 =====
RAG_CHUNK_SIZE=420
RAG_OVERLAP=80
RAG_TOP_K=4

# ===== 上下文预算 =====
CTX_MAX_ROUNDS=6
CTX_BUDGET_CHARS=6000
