# ===== 服务 =====
PORT=8325

# ===== 大模型（硅基流动 / 七牛云 / 任意 OpenAI 兼容平台）=====
LLM_BASE_URL=https://api.qnaigc.com/v1
LLM_MODEL=qiniu/conatus-free
LLM_API_KEY=请填写你的_API_KEY
LLM_TIMEOUT=90000
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1600

# ===== 数据库（MySQL 8.0；置为 false 时自动退化为本地 JSON 存储）=====
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=llm_rag

# ===== RAG 参数 =====
RAG_CHUNK_SIZE=420
RAG_OVERLAP=80
RAG_TOP_K=4

# ===== 上下文预算 =====
CTX_MAX_ROUNDS=6
CTX_BUDGET_CHARS=6000
